{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluation-validity-auditor.local/contracts/evaluation-result-record.v1.schema.json",
  "title": "EvaluationResultRecord.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "runId", "criterionId", "outcome", "value", "judgeActorId", "judgmentMethod", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "caseId": { "$ref": "#/$defs/token" },
    "runId": { "$ref": "#/$defs/token" },
    "criterionId": { "$ref": "#/$defs/token" },
    "outcome": { "enum": ["PASS", "FAIL", "ERROR"] },
    "value": { "type": ["number", "null"] },
    "judgeActorId": { "type": "string", "format": "uuid" },
    "judgmentMethod": { "enum": ["deterministic-oracle", "independent-review", "self-report", "lexical-match"] },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
  }
}
