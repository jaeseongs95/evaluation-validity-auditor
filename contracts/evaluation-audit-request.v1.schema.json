{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluation-validity-auditor.local/contracts/evaluation-audit-request.v1.schema.json",
  "title": "EvaluationAuditRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditId", "auditPhase", "auditedAt", "auditRoot", "target", "actors", "artifacts", "inventory", "runs", "semanticJudgments", "knownLimitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "auditId": { "$ref": "#/$defs/token" },
    "auditPhase": { "enum": ["pre-execution", "post-execution"] },
    "auditedAt": { "type": "string", "format": "date-time" },
    "auditRoot": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluationId", "frameDigest", "candidateDigest", "corpusDigest", "revision", "frameCreatedAt", "executionStartedAt"],
      "properties": {
        "evaluationId": { "$ref": "#/$defs/token" },
        "frameDigest": { "$ref": "#/$defs/digest" },
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "corpusDigest": { "$ref": "#/$defs/digest" },
        "revision": { "type": "string", "minLength": 1 },
        "frameCreatedAt": { "type": "string", "format": "date-time" },
        "executionStartedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorIds", "auditorId", "evaluatorIds", "adjudicatorIds"],
      "properties": {
        "authorIds": { "$ref": "#/$defs/actorArray" },
        "auditorId": { "$ref": "#/$defs/uuid" },
        "evaluatorIds": { "$ref": "#/$defs/actorArray" },
        "adjudicatorIds": { "$ref": "#/$defs/actorArray" }
      }
    },
    "artifacts": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/artifact" } },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestArtifactId", "caseIdField", "splitField", "splitPolicy", "expectedCaseCount", "expectedCaseIdsDigest", "expectedRunIds", "missingResultPolicy"],
      "properties": {
        "manifestArtifactId": { "$ref": "#/$defs/token" },
        "caseIdField": { "$ref": "#/$defs/token" },
        "splitField": { "type": ["string", "null"], "minLength": 1 },
        "splitPolicy": { "enum": ["none", "disjoint"] },
        "expectedCaseCount": { "type": "integer", "minimum": 1 },
        "expectedCaseIdsDigest": { "$ref": "#/$defs/digest" },
        "expectedRunIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "missingResultPolicy": { "enum": ["include-as-failure", "reject-incomplete"] }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "status", "resultArtifactId"],
        "properties": {
          "runId": { "$ref": "#/$defs/token" },
          "status": { "enum": ["completed", "failed", "timeout"] },
          "resultArtifactId": { "type": ["string", "null"], "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
            "then": { "properties": { "resultArtifactId": { "$ref": "#/$defs/token" } } },
            "else": { "properties": { "resultArtifactId": { "type": "null" } } }
          }
        ]
      }
    },
    "semanticJudgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "auditorActorId", "evidenceRefs", "code"],
        "properties": {
          "checkId": { "enum": ["ORACLE_FIT", "NON_SELF_REPORTED_EVIDENCE"] },
          "status": { "enum": ["PASS", "FAIL", "INSUFFICIENT_EVIDENCE", "NEEDS_INPUT"] },
          "auditorActorId": { "$ref": "#/$defs/uuid" },
          "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
          "code": { "enum": ["SEMANTIC_ORACLE_SUPPORTED", "LEXICAL_ORACLE_SCOPE_ONLY", "SEMANTIC_ORACLE_INADEQUATE", "INDEPENDENT_EVIDENCE_PRESENT", "SELF_REPORT_ONLY", "EVIDENCE_MISSING", "POLICY_AMBIGUOUS"] }
        }
      }
    },
    "knownLimitations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "actorArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "locator", "digest", "format", "availability", "visibleToRoles", "verified"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/token" },
        "kind": { "enum": ["frame", "corpus-manifest", "labels", "rubric", "oracle", "aggregation-policy", "thresholds", "run-output", "aggregate-report", "preflight-report", "evidence"] },
        "locator": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "format": { "enum": ["json", "jsonl", "text"] },
        "availability": { "enum": ["pre-execution", "post-execution"] },
        "visibleToRoles": { "type": "array", "uniqueItems": true, "items": { "enum": ["author", "auditor", "evaluator", "adjudicator"] } },
        "verified": { "type": "boolean" }
      }
    }
  }
}
