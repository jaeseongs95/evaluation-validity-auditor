{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluation-validity-auditor.local/contracts/evaluation-validity-report.v1.schema.json",
  "title": "EvaluationValidityReport.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditId", "auditPhase", "auditedAt", "auditorActorId", "target", "checks", "inventory", "recomputedMetrics", "recomputedMetricsDigest", "publishedMetricsDigest", "verifiedEvidenceIndex", "blockingCodes", "limitations", "verdict", "reportDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "auditId": { "$ref": "#/$defs/token" },
    "auditPhase": { "enum": ["pre-execution", "post-execution"] },
    "auditedAt": { "type": "string", "format": "date-time" },
    "auditorActorId": { "$ref": "#/$defs/uuid" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluationId", "frameDigest", "candidateDigest", "corpusDigest", "revision"],
      "properties": {
        "evaluationId": { "$ref": "#/$defs/token" },
        "frameDigest": { "$ref": "#/$defs/digest" },
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "corpusDigest": { "$ref": "#/$defs/digest" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "code", "evidenceRefs"],
        "properties": {
          "checkId": { "$ref": "#/$defs/checkId" },
          "status": { "enum": ["PASS", "FAIL", "INSUFFICIENT_EVIDENCE", "NEEDS_INPUT"] },
          "code": { "$ref": "#/$defs/code" },
          "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedCaseCount", "observedCaseCount", "expectedRunCount", "observedRunCount", "splitCounts"],
      "properties": {
        "expectedCaseCount": { "type": "integer", "minimum": 1 },
        "observedCaseCount": { "type": "integer", "minimum": 0 },
        "expectedRunCount": { "type": "integer", "minimum": 1 },
        "observedRunCount": { "type": "integer", "minimum": 0 },
        "splitCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "recomputedMetrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "recomputedMetricsDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "publishedMetricsDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "verifiedEvidenceIndex": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "kind", "locator", "digest"],
        "properties": {
          "artifactId": { "$ref": "#/$defs/token" },
          "kind": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "blockingCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
    "limitations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "verdict": { "enum": ["PASS", "FAIL", "BLOCKED", "NEEDS_INPUT"] },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "checkId": { "enum": ["FRAME_FROZEN", "TARGET_BOUND", "CORPUS_INVENTORY_VALID", "SPLIT_POLICY_VALID", "LABELS_HIDDEN", "RUBRIC_FROZEN", "AGGREGATION_FROZEN", "ROLE_INDEPENDENCE", "AUDITED_BEFORE_EXECUTION", "ORACLE_FIT", "NON_SELF_REPORTED_EVIDENCE", "PREFLIGHT_REPORT_BOUND", "RUN_SET_COMPLETE", "CASE_SET_COMPLETE", "FAILURES_PRESERVED", "NO_POSTHOC_CONTROL_CHANGE", "AGGREGATE_RECOMPUTED", "PUBLISHED_METRICS_MATCH"] },
    "code": { "enum": ["CHECK_PASSED", "ARTIFACT_MISSING", "ARTIFACT_UNVERIFIED", "DIGEST_MISMATCH", "FRAME_BINDING_INVALID", "FRAME_CREATED_AFTER_AUDIT", "CASE_DUPLICATE", "CASE_COUNT_MISMATCH", "CASE_ID_DIGEST_MISMATCH", "SPLIT_POLICY_INVALID", "LABEL_LEAKAGE", "CONTROL_NOT_FROZEN", "ROLE_CONFLICT", "AUDIT_AFTER_EXECUTION", "SEMANTIC_ORACLE_SUPPORTED", "LEXICAL_ORACLE_SCOPE_ONLY", "SEMANTIC_ORACLE_INADEQUATE", "INDEPENDENT_EVIDENCE_PRESENT", "SELF_REPORT_ONLY", "EVIDENCE_MISSING", "POLICY_AMBIGUOUS", "PREFLIGHT_REPORT_INVALID", "RUN_DUPLICATE", "RUN_SET_INCOMPLETE", "RESULT_PARSE_FAILED", "RESULT_SET_INCOMPLETE", "FAILURE_OMITTED", "CONTROL_CHANGED", "AGGREGATION_INVALID", "PUBLISHED_METRICS_MISMATCH", "UNSUPPORTED_FORMAT"] }
  }
}
