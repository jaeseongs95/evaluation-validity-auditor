{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluation-validity-auditor.local/contracts/evaluation-validity-report.v1.schema.json",
  "title": "EvaluationValidityReport.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditId", "auditStage", "auditedAt", "auditorActorId", "requestDigest", "target", "artifactBindings", "checks", "coverage", "recomputedMetrics", "verifiedEvidenceIndex", "blockingCodes", "limitations", "qualifiesAsQualityOrReleaseEvidence", "verdict", "reportDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "auditId": { "$ref": "#/$defs/token" },
    "auditStage": { "enum": ["pre-execution", "post-execution"] },
    "auditedAt": { "type": "string", "format": "date-time" },
    "auditorActorId": { "$ref": "#/$defs/uuid" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluationId", "identifier", "revision", "digest"],
      "properties": {
        "evaluationId": { "$ref": "#/$defs/token" },
        "identifier": { "$ref": "#/$defs/token" },
        "revision": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifactBindings": { "type": "array", "items": { "$ref": "#/$defs/artifactBinding" } },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "code", "evidenceRefs"],
        "properties": {
          "checkId": { "$ref": "#/$defs/checkId" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "code": { "$ref": "#/$defs/code" },
          "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedCases", "observedCases", "expectedRuns", "observedRuns", "expectedResults", "observedResults"],
      "properties": {
        "expectedCases": { "type": "integer", "minimum": 1 },
        "observedCases": { "type": "integer", "minimum": 0 },
        "expectedRuns": { "type": "integer", "minimum": 1 },
        "observedRuns": { "type": "integer", "minimum": 0 },
        "expectedResults": { "type": "integer", "minimum": 1 },
        "observedResults": { "type": "integer", "minimum": 0 }
      }
    },
    "recomputedMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metricId", "numerator", "denominator", "value", "comparator", "threshold", "claimedValue", "claimMatches", "thresholdPassed"],
        "properties": {
          "metricId": { "$ref": "#/$defs/token" },
          "numerator": { "type": "number" },
          "denominator": { "type": "integer", "minimum": 1 },
          "value": { "type": "number" },
          "comparator": { "enum": [">=", ">", "=", "<=", "<"] },
          "threshold": { "type": "number" },
          "claimedValue": { "type": "number" },
          "claimMatches": { "type": "boolean" },
          "thresholdPassed": { "type": "boolean" }
        }
      }
    },
    "verifiedEvidenceIndex": { "type": "array", "items": { "$ref": "#/$defs/artifactBinding" } },
    "blockingCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
    "limitations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "qualifiesAsQualityOrReleaseEvidence": { "type": "boolean" },
    "verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "role", "digest"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/token" },
        "role": { "enum": ["fixture-manifest", "rubric", "oracle", "aggregation-rule", "timing-evidence", "result-records", "aggregate-claim", "evidence"] },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "checkId": { "enum": ["ARTIFACT_INTEGRITY", "FRAME_FROZEN", "CASE_MANIFEST_COMPLETE", "ROLE_INDEPENDENCE", "JUDGMENT_METHOD_VALID", "AGGREGATION_RULE_VALID", "TIMING_PROVENANCE_VALID", "NO_POSTHOC_INPUT", "RUN_SET_COMPLETE", "RESULT_RECORDS_COMPLETE", "AGGREGATE_RECOMPUTED", "CLAIM_MATCHES"] },
    "code": { "enum": ["CHECK_PASSED", "ARTIFACT_MISSING", "DIGEST_MISMATCH", "REQUIRED_ARTIFACT_ROLE_INVALID", "FRAME_FROZEN_AFTER_AUDIT", "FRAME_FROZEN_AFTER_EXECUTION", "AUDIT_NOT_PRE_EXECUTION", "AUDIT_NOT_POST_EXECUTION", "RESULT_EVIDENCE_NOT_AVAILABLE_AT_AUDIT", "JSONL_PARSE_FAILED", "CASE_SCHEMA_INVALID", "CASE_DUPLICATE", "CASE_MISSING", "CASE_UNKNOWN", "CASE_ORDER_MISMATCH", "ROLE_CONFLICT", "SEMANTIC_LEXICAL_ONLY", "SELF_REPORT_ONLY", "JUDGMENT_METHOD_MISMATCH", "ORACLE_BINDING_INVALID", "PROVENANCE_MISSING", "POSTHOC_INPUT", "RUN_DUPLICATE", "RUN_MISSING", "RUN_UNKNOWN", "RESULT_SCHEMA_INVALID", "RESULT_DUPLICATE", "RESULT_MISSING", "RESULT_UNKNOWN", "AGGREGATION_INVALID", "AGGREGATE_CLAIM_MISSING", "AGGREGATE_CLAIM_INVALID", "AGGREGATE_MISMATCH"] }
  }
}
