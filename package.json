{
  "name": "evaluation-validity-auditor",
  "version": "1.0.0",
  "description": "Audit frozen evaluation designs and completed results for validity, completeness, leakage, and reproducible aggregation.",
  "type": "module",
  "bin": {
    "evaluation-validity-auditor": "./scripts/cli.mjs"
  },
  "scripts": {
    "cli": "node scripts/cli.mjs",
    "digest": "node scripts/digest-request.mjs",
    "lint": "node scripts/check-repository.mjs",
    "test": "node --test test/core.test.mjs",
    "runtime:check": "node scripts/runtime-smoke.mjs",
    "validate": "pnpm lint && pnpm test && pnpm runtime:check"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.19.0",
  "license": "MIT",
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
