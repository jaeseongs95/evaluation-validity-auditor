{
  "schemaVersion": "2.0.0",
  "providers": [
    {
      "skillId": "evaluation-validity-auditor",
      "version": "1.0.0",
      "enabled": true,
      "capabilities": ["evaluation-validity-audit"],
      "priority": 50,
      "executionClass": "workflow",
      "phase": "evaluation-validity",
      "phaseOrder": 68,
      "requiredInputArtifacts": ["evaluation-validity-request", "frozen-evaluation-frame", "evaluation-evidence"],
      "inputBindings": [
        { "targetArtifact": "evaluation-validity-request", "sources": ["workflow:evaluation-validity-request"], "operation": "require-external" },
        { "targetArtifact": "frozen-evaluation-frame", "sources": ["workflow:frozen-evaluation-frame"], "operation": "require-external" },
        { "targetArtifact": "evaluation-evidence", "sources": ["workflow:evaluation-evidence"], "operation": "collect" }
      ],
      "producedArtifacts": ["evaluation-validity-report", "verified-evaluation-evidence-index"],
      "outputSchema": "contracts/evaluation-validity-report.v1.schema.json",
      "resultSchema": "integration/provider-result.v1.schema.json",
      "stateMapping": {
        "selector": "/output/verdict",
        "values": {
          "PASS": { "state": "passed", "errorRequired": false },
          "FAIL": { "state": "failed", "errorRequired": true, "allowedErrorCodes": ["GATE_FAILED"] },
          "BLOCKED": { "state": "blocked", "errorRequired": true, "allowedErrorCodes": ["MISSING_EVIDENCE"] }
        },
        "default": "reject",
        "adapterErrors": ["INVALID_INPUT", "MISSING_EVIDENCE"]
      },
      "selectionCriteria": ["explicit-evaluation-validity-audit", "evaluation-result-used-as-quality-or-release-evidence"],
      "preconditions": ["A frozen evaluation request and inspectable evidence rooted in one explicit artifact directory are available."],
      "failureHandling": { "missingInput": "blocked", "invalidEvaluation": "failed", "retry": "new-or-corrected-evidence-only" },
      "gate": { "kind": "completion", "policy": "conditional", "validator": "contracts/evaluation-validity-report.v1.schema.json" },
      "receiptPolicy": { "mode": "reference-only", "actorIdPointer": "/output/auditorActorId", "uniqueness": "run" }
    }
  ]
}
