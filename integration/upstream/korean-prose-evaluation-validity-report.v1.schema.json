{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/korean-prose-evaluation-validity-report.v1.schema.json",
  "title": "KoreanProseEvaluationValidityReport.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frameId",
    "frameDigest",
    "corpusDigest",
    "status",
    "auditedAt",
    "executionStartedAt",
    "actors",
    "checks",
    "strataCounts",
    "evidence",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "frameId": { "type": "string", "minLength": 1 },
    "frameDigest": { "$ref": "#/$defs/digest" },
    "corpusDigest": { "$ref": "#/$defs/digest" },
    "status": { "enum": ["valid", "invalid", "insufficient-evidence"] },
    "auditedAt": { "type": "string", "format": "date-time" },
    "executionStartedAt": { "type": "string", "format": "date-time" },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "auditor", "adjudicator"],
      "properties": {
        "author": { "$ref": "#/$defs/actor" },
        "auditor": { "$ref": "#/$defs/actor" },
        "adjudicator": { "$ref": "#/$defs/actor" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceAuthoritative", "noDuplicateCases", "noCorpusOverlap", "strataComplete", "auditedBeforeExecution"],
      "properties": {
        "sourceAuthoritative": { "type": "boolean" },
        "noDuplicateCases": { "type": "boolean" },
        "noCorpusOverlap": { "type": "boolean" },
        "strataComplete": { "type": "boolean" },
        "auditedBeforeExecution": { "type": "boolean" }
      }
    },
    "strataCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyCount", "holdoutCount"],
      "properties": {
        "legacyCount": { "type": "integer", "minimum": 1 },
        "holdoutCount": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "digest", "verified"],
        "properties": {
          "locator": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "verified": { "const": true }
        }
      }
    },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "actor": { "type": "string", "format": "uuid" }
  }
}
